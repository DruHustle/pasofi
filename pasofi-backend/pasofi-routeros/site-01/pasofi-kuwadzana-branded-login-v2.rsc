{
# Kuwadzana offline-branded login. Run only in the existing pilot Safe Mode.
# The original HotSpot folder is copied; no guest forwarding is enabled.
:if ([/system device-mode get hotspot] != true) do={ :error "HotSpot is disabled in device mode" }
:if ([:len [/interface wireguard find where name="pamofi-service"]] != 1 || [/interface wireguard get [find where name="pamofi-service"] public-key] != "AMJXVTVrpj0512Eoj5A6DWNAnjySBPF3VmzODGeN/FE=") do={ :error "Wrong router" }
:if ([:len [/ip hotspot find where name="pfi-pilot-hotspot" and interface="pfi-pilot-br"]] != 1 || [:tostr [/ip hotspot get [find where name="pfi-pilot-hotspot"] profile]] != "pfi-pilot-https") do={ :error "Unexpected pilot HotSpot" }
:if ([:tostr [/ip hotspot profile get [find where name="pfi-pilot-https"] login-by]] != "https" || [/ip hotspot profile get [find where name="pfi-pilot-https"] dns-name] != "hotspot.pasofi.onesa.eu") do={ :error "Expected secure PasoFi profile" }
:local certName [/ip hotspot profile get [find where name="pfi-pilot-https"] ssl-certificate]
:if ([:len [/certificate find where name=$certName and trusted=yes and fingerprint="0b82c568ec209746a1be140b9d84124af8c46e1450257144230b68b62364e564"]] != 1) do={ :error "Expected trusted PasoFi certificate" }
:if ([:len [/ip firewall filter find where comment="PasoFi test: deny forward in" and chain=forward and in-interface="pfi-pilot-br" and action=drop]] != 1 || [:len [/ip firewall filter find where comment="PasoFi test: deny forward out" and chain=forward and out-interface="pfi-pilot-br" and action=drop]] != 1) do={ :error "IPv4 pilot isolation missing" }
:foreach pfiRule in=[/ip firewall filter find where comment~"^PasoFi test: deny forward"] do={ :if ([/ip firewall filter get $pfiRule disabled] = true || [/ip firewall filter get $pfiRule invalid] = true) do={ :error "Pilot forward deny rule is disabled or invalid" } }
:if ([:len [/ipv6 firewall filter find where comment="PasoFi test: deny forward in" and chain=forward and in-interface="pfi-pilot-br" and action=drop]] != 1 || [:len [/ipv6 firewall filter find where comment="PasoFi test: deny forward out" and chain=forward and out-interface="pfi-pilot-br" and action=drop]] != 1) do={ :error "IPv6 pilot isolation missing" }
:foreach pfiRule in=[/ipv6 firewall filter find where comment~"^PasoFi test: deny forward"] do={ :if ([/ipv6 firewall filter get $pfiRule disabled] = true || [/ipv6 firewall filter get $pfiRule invalid] = true) do={ :error "Pilot forward deny rule is disabled or invalid" } }
:local source [/ip hotspot profile get [find where name="pfi-pilot-https"] html-directory]
:if ([:len [/file find where name=$source and type=directory]] != 1 || [:len [/file find where name=($source . "/login.html")]] != 1) do={ :error "Cannot find the current HotSpot HTML folder and login file" }
:local target "pasofi-pilot-portal"
:if ([:len [/file find where name="flash" and type=disk]] = 1) do={ :set target "flash/pasofi-pilot-portal" }
:if ([:len [/file find where name=$target]] != 0) do={ :error "PasoFi portal folder already exists; inspect before retrying" }
/file copy $source name=$target
:if ([:len [/file find where name=($target . "/login.html")]] != 1) do={ :error "HotSpot copy is incomplete; profile not changed" }
:local page "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"referrer\" content=\"no-referrer\"><title>PasoFi | Connect</title><style>*{box-sizing:border-box}body{margin:0;background:#f7f4f4;color:#221a22;font:16px/1.5 system-ui,-apple-system,sans-serif}.bar{background:#b71338;color:white;padding:16px 20px;font-size:25px;font-weight:850;letter-spacing:-1px}.bar span{color:#ffd2da}main{max-width:440px;margin:auto;padding:28px 18px}.tag{color:#ae1134;font-size:12px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase}h1{font-size:30px;line-height:1.15;letter-spacing:-.8px;margin:10px 0}p{margin:0 0 20px;color:#62535a}.card{background:white;padding:22px;border-radius:18px;box-shadow:0 8px 32px #48202c12}label{display:block;font-weight:700;margin:0 0 6px}input{display:block;width:100%;padding:13px;border:1px solid #d8cdd0;border-radius:9px;font:inherit;margin-bottom:16px}input:focus{outline:3px solid #ffd3dc;border-color:#ba1640}button{border:0;border-radius:9px;background:#b71338;color:white;font:inherit;font-weight:750;width:100%;padding:14px;cursor:pointer}.note{font-size:13px;margin:16px 0 0;color:#675b60}.help{margin:22px 3px;font-size:14px}.help a{color:#a00f30;font-weight:700}.small{font-size:12px;color:#75686e}</style></head><body><div class=\"bar\">Paso<span>Fi</span></div><main><div class=\"tag\">Kuwadzana &bull; Pilot</div><h1>Welcome to PasoFi</h1><p>Enter your temporary hotspot details to connect.</p><div class=\"card\"><form action=\"https://hotspot.pasofi.onesa.eu/login\" method=\"post\"><label for=\"u\">Hotspot username</label><input id=\"u\" name=\"username\" autocomplete=\"username\" required><label for=\"p\">Hotspot password</label><input id=\"p\" name=\"password\" type=\"password\" autocomplete=\"current-password\" required><button type=\"submit\">Connect securely</button></form><p class=\"note\">If you cannot connect, check your hotspot details and try again.</p></div><p class=\"help\">Need help? <a href=\"tel:+263715092221\">+263 715 092 221</a></p><p class=\"small\">Pilot testing is in progress. Internet access and sales are not yet enabled.</p></main></body></html>"
/file set [find where name=($target . "/login.html")] contents=$page
:if ([/file get [find where name=($target . "/login.html")] contents] != $page) do={ :error "Login file verification failed; profile not changed" }
/ip hotspot profile set [find where name="pfi-pilot-https"] html-directory=$target
:put ("PasoFi login prepared in " . $target . ". Keep Safe Mode open while testing.")
:put "Pilot internet and sales remain blocked."
}
