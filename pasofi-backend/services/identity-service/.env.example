DATABASE_URL=postgresql://pamofi_identity:demo_only_change_me@localhost:55432/pamofi_identity
PORT=3000
APP_ENV=demo
PUBLIC_ORIGIN=http://localhost:5173
NODE_ENV=development
INTERNAL_IDENTITY_SECRET=DEMO_ONLY_insecure_local_service_secret_123456789
SESSION_CREATION_SECRET=DEMO_ONLY_insecure_local_session_creation_secret_123456789
# Synthetic demo key only. Generate an independent random32-byte hex key for
# staging/production and retain it in the deployment secret store and backup plan.
STAFF_MFA_ENCRYPTION_KEY=abababababababababababababababababababababababababababababababab
# Unset by default. A production reverse proxy must overwrite X-Forwarded-For;
# explicitly trust only its private service-network CIDR, never0.0.0.0/0 or::/0.
# PAMOFI_TRUST_PROXY_CIDRS=172.30.16.0/24

# Staff recovery uses the existing SMTP transport. These example values do not
# qualify Resend: retain REQUIRETLS and disabled flags; see ../../docs/STAFF_RECOVERY.md.
STAFF_RESET_DELIVERY_ENABLED=false
STAFF_RESET_DELIVERY_QUALIFIED=false
STAFF_RESET_SMTP_HOST=smtp.resend.com
STAFF_RESET_SMTP_PORT=465
STAFF_RESET_SMTP_USER=resend
STAFF_RESET_EMAIL_FROM=notifications-pasofi@onesa.eu
# Local example only. Production loads the existing protected password secret file.
STAFF_RESET_SMTP_PASSWORD=
