# Opt-in deployment inputs; keep values false until the controlled activation
# and physical acceptance plan has been reviewed. No live secret belongs here.
PAMOFI_RADIUS_QUALIFIED=false
PAMOFI_CUSTOMER_NETWORK_ENABLED=false
PAMOFI_RADIUS_TUNNEL_IP=REPLACE_WITH_ORACLE_WIREGUARD_PRIVATE_IPV4
PAMOFI_RADIUS_SECRETS_DIR=/absolute/protected/radius-material
# Optional operations checker scope, exactly equal to the reviewed host bind:
PAMOFI_OPERATIONS_RADIUS_BIND=REPLACE_WITH_ORACLE_WIREGUARD_PRIVATE_IPV4
