# Render only with vercel-entrypoint.sh. The rendered file contains a bearer
# credential and must remain private. Never print it with nginx -T.
map $http_x_pamofi_proxy_token $pamofi_proxy_authorized {
  default 0;
  "~^__PAMOFI_PROXY_TOKEN__$" 1;
}
map $http_x_pamofi_client_ip $pamofi_client_shape {
  default 0;
  "~^[0-9.]+$" 1;
  "~^[0-9a-f:]+$" 1;
}
# Nginx's address parser rejects malformed addresses. Its normalized output must
# also exactly match the single header, excluding lists, ports, spaces, zones,
# noncanonical IPv6 and dotted mapped-IPv6 (the Vercel proxy emits plain IPv4).
map "$http_x_pamofi_client_ip|$remote_addr" $pamofi_client_canonical {
  default 0;
  "~^([^|]+)\\|\\1$" 1;
}
server {
  listen 80;
  server_name __PAMOFI_PUBLIC_HOST__;
  return 308 https://__PAMOFI_PUBLIC_HOST__$request_uri;
}
server {
  listen 443 ssl;
  server_name __PAMOFI_PUBLIC_HOST__;
  ssl_certificate /run/secrets/public_tls_cert;
  ssl_certificate_key /run/secrets/public_tls_key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_tickets off;
  client_max_body_size 32k;
  server_tokens off;
  access_log off;
  resolver 127.0.0.11 valid=5s ipv6=off;
  # This header becomes authoritative ONLY after the secret check below.
  # Never use X-Forwarded-For, Forwarded or X-Real-IP from a public caller.
  set_real_ip_from 0.0.0.0/0;
  set_real_ip_from ::/0;
  real_ip_header X-PamoFi-Client-IP;
  real_ip_recursive off;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header Cache-Control no-store always;
  add_header Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self' https://hotspot.pasofi.onesa.eu https://hotspot.pamofi.onesa.eu" always;
  default_type application/json;
  __PASOFI_HOTSPOT_PORTAL_INCLUDE__
  location = /health/live { return 200 '{"status":"ok","service":"gateway"}'; }
  location /api/ {
    if ($pamofi_proxy_authorized = 0) { return 403 '{"error":"proxy_authentication_required"}'; }
    if ($pamofi_client_shape = 0) { return 400 '{"error":"invalid_proxy_client"}'; }
    if ($pamofi_client_canonical = 0) { return 400 '{"error":"invalid_proxy_client"}'; }
    # The private web service retains the independently tested API allowlist.
    set $web web;
    proxy_pass http://$web:80;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Forwarded "";
    proxy_set_header X-Vercel-Forwarded-For "";
    proxy_set_header X-PamoFi-Proxy-Token "";
    proxy_set_header X-PamoFi-Client-IP "";
    proxy_set_header Connection "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;
    proxy_send_timeout 15s;
  }
  location / { return 404 '{"error":"not_found"}'; }
}
