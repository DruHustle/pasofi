server {
  listen 80;
  server_name ${PAMOFI_PUBLIC_HOST};
  return 308 https://${PAMOFI_PUBLIC_HOST}$request_uri;
}
server {
  listen 443 ssl;
  server_name ${PAMOFI_PUBLIC_HOST};
  ssl_certificate /run/secrets/public_tls_cert;
  ssl_certificate_key /run/secrets/public_tls_key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_tickets off;
  client_max_body_size 32k;
  server_tokens off;
  access_log off;
  resolver 127.0.0.11 valid=5s ipv6=off;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  location /internal/ { default_type application/json; return 404 '{"error":"not_found"}'; }
  location /v1/ { default_type application/json; return 404 '{"error":"not_found"}'; }
  location = /health/live { default_type application/json; return 200 '{"status":"ok","service":"gateway"}'; }
  location = /callbacks/stripe {
    limit_except POST { deny all; }
    client_max_body_size 256k;
    set $web web;
    proxy_pass http://$web:80/callbacks/stripe;
    proxy_set_header Stripe-Signature $http_stripe_signature;
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_set_header X-Forwarded-For $remote_addr;
  }
  location / {
    set $web web;
    proxy_pass http://$web:80;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Discard user-supplied proxy chains at the sole public ingress.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;
    proxy_send_timeout 15s;
  }
}
