# Server-only Vercel function settings. Set these in the Vercel project's
# appropriate environment and redeploy. Never add a VITE_ prefix.
# Leave ordinary previews unconfigured; use an independent staging backend/token
# for any preview that must have a working API.
PAMOFI_PUBLIC_ORIGIN=
PAMOFI_ORACLE_API_ORIGIN=
PAMOFI_VERCEL_PROXY_TOKEN=
NODEJS_HELPERS=0

# VERCEL=1 is supplied by Vercel itself, not a public self-hosted trust switch.
# The origins must be distinct canonical HTTPS DNS origins with no trailing
# slash, path, port, credentials or query. The proxy token is 64 lowercase hex
# characters and must match Oracle's vercel_proxy_token secret.

# Optional local Vite development service targets (not production routing):
# PAMOFI_IDENTITY_URL=http://localhost:18081
# PAMOFI_PREPAID_URL=http://localhost:18082
# PAMOFI_ASSISTANT_URL=http://localhost:18085
