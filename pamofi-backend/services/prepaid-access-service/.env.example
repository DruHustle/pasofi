DATABASE_URL=postgresql://pamofi_prepaid_access:demo_only_change_me@localhost:55432/pamofi_prepaid_access
PORT=3000
APP_ENV=demo
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:5173
IDENTITY_URL=http://localhost:18081
INTERNAL_IDENTITY_SECRET=DEMO_ONLY_insecure_local_service_secret_123456789
# Explicit private proxy IPs/CIDRs only; unset ignores forwarded client headers.
PAMOFI_TRUST_PROXY_CIDRS=
PAMOFI_COMMERCE_ENABLED=false
PAMOFI_AGENT_COMMISSION_BPS=0
VOUCHER_DELIVERY_ACTIVE_KEY_ID=
VOUCHER_DELIVERY_KEYS_JSON={}
PAMOFI_SMS_DELIVERY_ENABLED=false
NOTIFICATION_URL=http://localhost:18084
INTERNAL_DELIVERY_SECRET=
OUTBOX_DISPATCH_ENABLED=false
INTERNAL_EVENTS_SECRET=
PAMOFI_PAYMENTS_ENABLED=false
PAMOFI_PAYMENT_MODE=disabled
# Only mock in demo/development is selectable. Real provider/bank checkout has
# no runtime enablement path until a direct settlement contract is qualified.
# Leave the provider selector unset, or use exactly mock for an enabled demo.
# Any other explicit value (including empty) disables checkout; a real bank or
# provider name never falls back to mock. The disabled defaults above stay off.
# PAMOFI_PAYMENT_PROVIDER=mock
PAMOFI_CUSTOMER_NETWORK_ENABLED=false
NETWORK_URL=http://localhost:18083
INTERNAL_NETWORK_SECRET=
INTERNAL_RADIUS_ENABLED=false
PAMOFI_RADIUS_QUALIFIED=false
