DATABASE_URL=postgresql://pamofi_network:demo_only_change_me@localhost:55432/pamofi_network
PORT=3000
HOST=127.0.0.1
APP_ENV=demo
NODE_ENV=development
# Enable only in an isolated lab or after actual router acceptance.
PAMOFI_CUSTOMER_NETWORK_ENABLED=false
INTERNAL_RADIUS_ENABLED=false
PAMOFI_RADIUS_QUALIFIED=false
NETWORK_RECONCILER_ENABLED=false
# Supply independent real secrets from protected files outside source control.
INTERNAL_NETWORK_SECRET=
RADIUS_CREDENTIAL_KEY_VERSION=1
RADIUS_CREDENTIAL_KEYS=
PREPAID_URL=https://prepaid.internal
ROUTEROS_ROUTERS_FILE=
# Separate mutually authenticated listener (not started by npm start).
RADIUS_LISTEN_HOST=127.0.0.1
RADIUS_LISTEN_PORT=3443
RADIUS_CA_FILE=
RADIUS_SERVER_CERT_FILE=
RADIUS_SERVER_KEY_FILE=
RADIUS_CLIENT_FINGERPRINT=
