{
# Lawfield Farm: FIRST-STAGE PREPARATION ONLY, not a working hotspot.
# Download a password-protected router backup and retain independent local
# recovery first. Import in Safe Mode after connecting to the site 2 router.
# The private key is generated by and remains on this router.
:if ([:pick [/system resource get version] 0 2] != "7.") do={ :error "Lawfield preparation requires RouterOS 7" }
:if ([:len [/interface find where name="pamofi-service"]] != 0) do={ :error "pamofi-service already exists; inspect existing configuration" }
:if ([:len [/interface wireguard find where listen-port=51821]] != 0) do={ :error "UDP port 51821 is already used by another WireGuard interface" }
:put ("Lawfield model: " . [/system resource get board-name])
:put ("RouterOS version: " . [/system resource get version])
:put ("Existing hotspot servers: " . [:len [/ip hotspot find]])
:put ("Existing RADIUS entries: " . [:len [/radius find]])
:put "Lawfield installed packages:"
/system package print
:put "Lawfield interfaces:"
/interface print terse
:put "Lawfield IPv4 addresses:"
/ip address print terse
:put "Lawfield IPv4 routes:"
/ip route print terse
:put "Lawfield address pools:"
/ip pool print terse
/interface wireguard add name="pamofi-service" listen-port=51821 disabled=yes comment="PamoFi site02: disabled service preparation"
:put ("Lawfield service interface disabled: " . [/interface wireguard get [find where name="pamofi-service"] disabled])
:put ("Lawfield router PUBLIC key: " . [/interface wireguard get [find where name="pamofi-service"] public-key])
:put "No peer, address, route, hotspot, RADIUS secret or customer access was configured."
}
